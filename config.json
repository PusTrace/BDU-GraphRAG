{
  "api": {
    "threats": {
      "endpoint": "/site-api/v1/Threats",
      "page_include": [
        "technics.techgroups"
      ],
      "item_include": [
        "impact",
        "objects.components",
        "technics"
      ]
    },
    "technics": {
      "endpoint": "/site-api/v1/Technics",
      "page_include": [],
      "item_include": [
        "potential",
        "defenses",
        "techgroups",
        "threats",
        "components"
      ]
    },
    "techgroups": {
      "endpoint": "/site-api/v1/Techgroups",
      "page_include": [
        "technics",
        "technics.components"
      ],
      "item_include": []
    },
    "objects": {
      "endpoint": "/site-api/v1/Objects",
      "page_include": [
        "components.cmptype"
      ],
      "item_include": [
        "components"
      ]
    },
    "components": {
      "endpoint": "/site-api/v1/Components",
      "page_include": [
        "cmptype",
        "technics.components",
        "technics.potential",
        "technics.defenses.parent",
        "technics.techgroups.technics"
      ],
      "item_include": []
    },
    "cmptypes": {
      "endpoint": "/site-api/v1/CmpTypes",
      "page_include": [
        "components.childs"
      ],
      "item_include": []
    },
    "negatives": {
      "endpoint": "/site-api/v1/Negatives",
      "page_include": [],
      "item_include": [
        "threats",
        "damagetype"
      ]
    },
    "potentials": {
      "endpoint": "/site-api/v1/Potentials",
      "page_include": [
        "intviews"
      ],
      "item_include": []
    },
    "defgroups": {
      "endpoint": "/site-api/v1/Defgroups",
      "page_include": [
        "defenses.childs"
      ],
      "item_include": []
    },
    "defenses": {
      "endpoint": "/site-api/v1/Defenses",
      "page_include": [],
      "item_include": [
        "group",
        "parent",
        "technics.threats"
      ]
    }
  },
  "parser": {
    "cmptypes": {
      "roots": [
        {
          "type": "cmptype",
          "source": "data"
        },
        {
          "type": "cmp",
          "source": "included"
        }
      ],
      "relations": [
        {
          "from": "cmptype",
          "relation": "components",
          "to": "cmp",
          "edge": "HAS_COMPONENT"
        },
        {
          "from": "cmp",
          "parent": "parent_id",
          "edge": "HAS_CHILD"
        }
      ]
    },
    "components": {
      "roots": [
        {
          "type": "cmp",
          "source": "data"
        },
        {
          "type": "defense",
          "source": "included"
        }
      ],
      "relations": [
        {
          "from": "cmp",
          "relation": "cmptype",
          "to": "cmptype",
          "edge": "BELONGS_TO_TYPE"
        },
        {
          "from": "cmp",
          "relation": "technics",
          "to": "technic",
          "edge": "HAS_TECHNIC"
        },
        {
          "from": "cmp",
          "parent": "parent_id",
          "edge": "HAS_CHILD"
        },
        {
          "from": "defense",
          "parent": "parent_id",
          "edge": "HAS_CHILD"
        }
      ]
    },
    "defenses": {
      "roots": [
        {
          "type": "defense",
          "source": "data"
        }
      ],
      "relations": [
        {
          "from": "defense",
          "parent": "parent_id",
          "edge": "HAS_CHILD"
        }
      ]
    },
    "defgroups": {
      "roots": [
        {
          "type": "defgroup",
          "source": "data"
        },
        {
          "type": "defense",
          "source": "included"
        }
      ],
      "relations": [
        {
          "from": "defgroup",
          "relation": "defenses",
          "to": "defense",
          "edge": "HAS_DEFENSE"
        },
        {
          "from": "defense",
          "relation": "childs",
          "to": "defense",
          "edge": "HAS_CHILD"
        },
        {
          "from": "defense",
          "parent": "parent_id",
          "edge": "HAS_CHILD"
        }
      ]
    },
    "negatives": {
      "roots": [
        {
          "type": "negative",
          "source": "data"
        }
      ],
      "relations": []
    },
    "objects": {
      "roots": [
        {
          "type": "object",
          "source": "data"
        },
        {
          "type": "cmp",
          "source": "included"
        }
      ],
      "relations": [
        {
          "from": "object",
          "relation": "components",
          "to": "cmp",
          "edge": "HAS_COMPONENT"
        },
        {
          "from": "cmp",
          "relation": "cmptype",
          "to": "cmptype",
          "edge": "BELONGS_TO_TYPE"
        },
        {
          "from": "cmp",
          "parent": "parent_id",
          "edge": "HAS_CHILD"
        }
      ]
    },
    "potentials": {
      "roots": [
        {
          "type": "potential",
          "source": "data"
        },
        {
          "type": "intview",
          "source": "included"
        }
      ],
      "relations": [
        {
          "from": "potential",
          "relation": "intviews",
          "to": "intview",
          "edge": "HAS_INTVIEW"
        }
      ]
    },
    "techgroups": {
      "roots": [
        {
          "type": "techgroup",
          "source": "data"
        },
        {
          "type": "technic",
          "source": "included"
        }
      ],
      "relations": [
        {
          "from": "techgroup",
          "relation": "technics",
          "to": "technic",
          "edge": "HAS_TECHNIC"
        },
        {
          "from": "technic",
          "relation": "components",
          "to": "cmp",
          "edge": "AFFECTS_COMPONENT"
        }
      ]
    },
    "technics": {
      "roots": [
        {
          "type": "technic",
          "source": "data"
        }
      ],
      "relations": [
        {
          "from": "technic",
          "fk": "pot_id",
          "to": "potential",
          "edge": "HAS_POTENTIAL"
        }
      ]
    },
    "threats": {
      "roots": [
        {
          "type": "threat",
          "source": "data"
        },
        {
          "type": "technic",
          "source": "included"
        }
      ],
      "relations": [
        {
          "from": "threat",
          "relation": "technics",
          "to": "technic",
          "edge": "CAUSED_BY"
        },
        {
          "from": "technic",
          "relation": "techgroups",
          "to": "techgroup",
          "edge": "BELONGS_TO_GROUP"
        }
      ]
    }
  },
  "files": {
    "cmptypes": "data/cmptypes_list.json",
    "components": "data/components_list.json",
    "defenses": "data/defenses_list.json",
    "defgroups": "data/defgroups_list.json",
    "negatives": "data/negatives_list.json",
    "objects": "data/objects_list.json",
    "potentials": "data/potentials_list.json",
    "techgroups": "data/techgroups_list.json",
    "technics": "data/technics_list.json",
    "threats": "data/threats_list.json"
  },
  "output": {
    "nodes": "data/nodes.json",
    "edges": "data/edges.json"
  },
  "en-ru": {
    "affects_component": "воздействует на компонент",
    "has_component": "содержит компонент",
    "has_child": "содержит подкомпонент",
    "has_defense": "содержит меру защиты",
    "belongs_to_group": "относится к группе",
    "belongs_to_type": "относится к типу",
    "caused_by": "реализуется через",
    "has_potential": "имеет потенциал",
    "has_intview": "имеет модель нарушителя",
    "has_technic": "подвержен воздействию метода"
  }
}
